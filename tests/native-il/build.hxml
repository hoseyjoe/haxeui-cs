# The ported C# alone under hxc, with no HaxeUI: `HXC=<hxc binary> sh tests/native-il/run.sh`.
-cp haxe
-cp tests/native-il
-main Main
--cs tests/native-il/bin
-D dotnet
-D unsafe
-D net-ver=45
--net-lib tests/bin/bin/Debug/net10.0/Avalonia.Base.dll
--net-lib tests/bin/bin/Debug/net10.0/Avalonia.Controls.dll
--net-lib tests/bin/bin/Debug/net10.0/SkiaSharp.dll
--net-lib tests/bin/bin/Debug/net10.0/Avalonia.Skia.dll
