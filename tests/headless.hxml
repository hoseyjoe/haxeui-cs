# The backend's test suite: builds the C# app headlessly, then runs it.
# `haxe tests/headless.hxml` from the repo root; add `-D test=<Case>` for one case.
-cp tests
-main TestMain
-lib utest
-lib haxeui-core
-lib haxeui-cs
-D haxeui_cs_headless
--resource tests/assets/red4x4.png@red4x4.png
--resource tests/assets/slice9.png@slice9.png
--resource tests/assets/slice9-pattern.png@slice9-pattern.png
--resource tests/assets/checker2x2.png@checker2x2.png
# a resource name the generated .csproj must escape
--resource tests/assets/red4x4.png@odd name & co.png
--resource tests/assets/DejaVuSansMono.ttf@fonts/DejaVuSansMono.ttf
-D haxeui_cs_run
# Every core component and container, used or not, so the C# build covers them all.
--macro include('haxe.ui.components')
--macro include('haxe.ui.containers', true)
-cs tests/bin
# Core's compile warnings print after the run's own output; keep the results last.
-w -WAll
