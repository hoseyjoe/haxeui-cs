<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated by haxeui-cs (haxe/ui/backend/cs/macros/Build.hx) on every Android build; edits are lost. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AssemblyName>::ASSEMBLY::</AssemblyName>
    <!-- Not the app's name: Android generates its Resource class in this namespace, and a
         namespace `Main` collides with Haxe's top-level class `Main`. -->
    <RootNamespace>HaxeUICs.App</RootNamespace>
    <ApplicationId>::APP_ID::</ApplicationId>
    <ApplicationTitle>::LABEL::</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <RuntimeIdentifier>::RID::</RuntimeIdentifier>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- The assemblies go inside the APK, so `adb install` alone installs a working app. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- A debug build is never trimmed (see the Release group below). -->
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
    <!-- JIT, not the Mono interpreter a debug build otherwise gets: the interpreter answers
         `((object)o).GetType()` inside Haxe's Type.getClass<object> with System.Object, so every
         component's class name is "Dynamic" and no theme CSS selector matches it. -->
    <UseInterpreter>false</UseInterpreter>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);HAXEUI_CS_ANDROID</DefineConstants>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0164;CS0168;CS0169;CS0219;CS0414;CS0649;CS0659;CS0661;CS1717;CS8981;CS0618</NoWarn>
  </PropertyGroup>
  <!-- `-D haxeui_cs_publish`: about half the size of a debug APK. Only the libraries that declare
       themselves trimmable are trimmed (.NET's own, AndroidX's, Avalonia's); the app's assembly is
       not one, so Haxe's output and HaxeUI still find every class by name. No AOT: Release turns
       profiled AOT on, which adds 2 MB of machine code for a faster start; no symbols either. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
::SOURCES::
::NATIVE_DIR::
::RESOURCES::
  </ItemGroup>
  <ItemGroup>
::PACKAGES::
  </ItemGroup>
</Project>
